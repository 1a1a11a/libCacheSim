        <mxGraphModel dx="712" dy="540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="gma_title" value="GroupMergeAdaptive — position-driven E and skip probability" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="gma_subtitle" value="skip_prob = skip_prob_max × (1 − position)&#xa;E = e_start + (e_max − e_start) × position&#xa;position = bytes_advanced / cache_size  (0 at tail, 1 at head)" style="text;fontSize=12;align=left" parent="1" vertex="1">
                    <mxGeometry x="40" y="55" width="700" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="gma_tail_lbl" value="TAIL (position ≈ 0)" style="text;align=center;fontSize=11;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="40" y="210" width="110" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_head_lbl" value="HEAD (position ≈ 1)" style="text;align=center;fontSize=11;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="1130" y="210" width="140" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_q" value="FIFO queue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="150" y="180" width="1000" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="gma_skip_label" value="skip_prob high (≈ skip_prob_max)" style="text;fontSize=10;fontStyle=2;fontColor=#b85450;align=center" parent="1" vertex="1">
                    <mxGeometry x="150" y="240" width="280" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_skip_mid" value="skip_prob decays linearly" style="text;fontSize=10;fontStyle=2;fontColor=#d79b00;align=center" parent="1" vertex="1">
                    <mxGeometry x="470" y="240" width="300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_skip_low" value="skip_prob ≈ 0" style="text;fontSize=10;fontStyle=2;fontColor=#82b366;align=center" parent="1" vertex="1">
                    <mxGeometry x="820" y="240" width="300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_e_label" value="E small (e.g. 2)" style="text;fontSize=10;fontStyle=2;fontColor=#6c8ebf;align=center" parent="1" vertex="1">
                    <mxGeometry x="150" y="265" width="280" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_e_mid" value="E grows linearly" style="text;fontSize=10;fontStyle=2;fontColor=#6c8ebf;align=center" parent="1" vertex="1">
                    <mxGeometry x="470" y="265" width="300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_e_high" value="E large (e.g. 16)" style="text;fontSize=10;fontStyle=2;fontColor=#6c8ebf;align=center" parent="1" vertex="1">
                    <mxGeometry x="820" y="265" width="300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_a_title" value="Example A — near TAIL (fast path):" style="text;fontSize=13;fontStyle=1;align=left" parent="1" vertex="1">
                    <mxGeometry x="40" y="320" width="420" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_a_step1" value="1. Coin flip (p ≈ 0.8) → SKIP one group: cursor hops group_size, no eviction." style="text;fontSize=11;align=left" parent="1" vertex="1">
                    <mxGeometry x="60" y="345" width="700" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_a_step2" value="2. Coin flip → do merge scan of just E=2 groups, sort, retain 1 group-worth, evict the rest (in place)." style="text;fontSize=11;align=left" parent="1" vertex="1">
                    <mxGeometry x="60" y="365" width="800" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_b_title" value="Example B — near HEAD (thorough):" style="text;fontSize=13;fontStyle=1;align=left" parent="1" vertex="1">
                    <mxGeometry x="40" y="410" width="420" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="gma_b_step1" value="skip_prob ≈ 0, almost never skips; scans E ≈ 16 groups, thorough sort/retain." style="text;fontSize=11;align=left" parent="1" vertex="1">
                    <mxGeometry x="60" y="435" width="800" height="20" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="gma2" name="GroupMergeAdaptive2">
        <mxGraphModel dx="712" dy="540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="gma2_title" value="GroupMergeAdaptive2 — activity-driven (seen bit), deterministic skip &amp; variable merge" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="1350" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="gma2_rules" value="Rules (per eviction call):&#xa;  • per object: seen=1 on access; scanner clears seen=0 when it COMMITS the object to a merge window.&#xa;  • active_ratio(group) = active_bytes / total_bytes&#xa;  • if NOT yet merging AND active_ratio &gt; 50% → SKIP (cursor hops past group, seen bits PRESERVED)&#xa;  • else commit group to window, keep merging more groups until Σ active_bytes ≥ group_size (≈ 100%), capped by e_max" style="text;fontSize=11;align=left;verticalAlign=top" parent="1" vertex="1">
                    <mxGeometry x="20" y="60" width="1350" height="100" as="geometry"/>
